#include <stdio.h>
int main() {
   int arr[MAX_SIZE];
   int size, num, pos, i;
   printf("Enter size of the array: ");
   scanf("%d", &size);
    printf("Enter elements in the array: ");
   for (i = 0; i < size; i++) {
       scanf("%d", &arr[i]);
   }
   printf("Enter element to insert: ");
   scanf("%d", &num);
   printf("Enter position to insert (1-based index): ");
   scanf("%d", &pos);
   if (pos < 1 || pos > size + 1) {
       printf("Invalid position! Please enter a position between 1 and %d.\n", size + 1);
       return 1;
   }
   for (i = size; i >= pos; i--) {
       arr[i] = arr[i - 1];
   }
   arr[pos - 1] = num;
   size++;
   printf("Array after insertion: ");
   for (i = 0; i < size; i++) {
       printf("%d ", arr[i]);
   }
   return 0;
}
