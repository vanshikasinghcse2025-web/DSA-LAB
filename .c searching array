#include<stdio.h>
int main( {
int n, i, key, found=0;
printf("Enter the number of elements: ");
scanf("%d", &n);
int a[n];
printf("Enter %d elements:\n",n);
for(i=0;i<n;i++) {
scanf("%d",&a[i]);
}
printf(Enter the elements to search (key): ");
scanf("%d", &key);
for(i=0;i<n;i++);
if(a[i]==key) {
found=i;
break;}}
if(found==i) {
printf("Elements %d found at index position %d.\n",key,i);
} else {
printf("Element %d is not found in array.\n",key);
}
return 0;
}
